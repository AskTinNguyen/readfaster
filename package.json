{
  "name": "readfaster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read AI output faster: a reading-speed trainer plus a CLI and MCP server so your own agent can drive it.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "bin": {
    "readfaster": "bin/readfaster.cjs"
  },
  "files": [
    "bin/"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AskTinNguyen/readfaster.git"
  }
}
